# ==========================================================================
# ARQUIVO DE VARIÁVEIS DE AMBIENTE - DriveRent API
# ==========================================================================
# Copie este arquivo para um novo arquivo chamado ".env" na raiz do projeto
# e ajuste os valores conforme necessário.
#
#   cp .env.example .env
#
# O arquivo ".env" NUNCA deve ser enviado para o Git (ele já está no
# .gitignore), pois normalmente guarda segredos e credenciais sensíveis.
# ==========================================================================

# Porta HTTP em que o servidor Express vai ficar disponível.
PORT=3333

# ---------------------------------------------------------------------------
# DATABASE_URL: string de conexão usada pelo Prisma para falar com a base
# de dados.
#
# Por padrão este projeto vem configurado com SQLite, porque não exige
# nenhuma instalação extra (o "banco" é apenas um arquivo local) — ideal
# para a sala de aula.
DATABASE_URL="file:./dev.db"
#
# Se preferir usar PostgreSQL, siga os passos abaixo:
#   1. No arquivo prisma/schema.prisma, troque:
#        provider = "sqlite"     ->     provider = "postgresql"
#   2. Substitua a linha DATABASE_URL acima por algo como:
#        DATABASE_URL="postgresql://usuario:senha@localhost:5432/driverent?schema=public"
#   3. Rode novamente "npx prisma migrate dev --name init".
# ---------------------------------------------------------------------------

# Segredo usado para ASSINAR e VALIDAR os tokens JWT (JSON Web Token).
# Em produção, use uma string longa, aleatória e mantida em sigilo.
JWT_SECRET="driverent_super_secreto_troque_em_producao"

# Tempo de validade do token JWT emitido no login (formato aceito pela lib "jsonwebtoken").
JWT_EXPIRES_IN="1d"
